---
import { contacts, links } from '../data/site';
const mail = (c: (typeof contacts)[number]) => `mailto:${c.email}?subject=${encodeURIComponent(c.subject)}`;
---
<section id="work-with-us" class="section bg-lime text-graphite">
  <div class="wrap grid items-start gap-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:gap-16">
    <div class="grid gap-3 md:gap-4">
      <span class="eyebrow text-lime-ink" data-reveal>Work with us</span>
      <h2 class="font-display text-[30px] leading-[1.02] tracking-[-.035em] md:text-[clamp(38px,6svh,56px)]" data-reveal>Bring the map to your vineyard.</h2>
      <p class="lede" data-reveal>VinePT-Map is developed at PIC4SeR, the Interdepartmental Centre for Service Robotics at Politecnico di Torino. We want to hear from robotics teams, machine makers and agronomists who need a map that lasts the whole season.</p>
      <ul class="mt-1 hidden flex-wrap gap-2 text-[13.5px] font-medium sm:flex" data-reveal>
        {['Field trials', 'Research collaborations', 'Industry pilots', 'Dataset access'].map((t) => <li class="rounded-full border border-graphite/40 px-3 py-1.5">{t}</li>)}
      </ul>
    </div>
    <div class="grid gap-2.5" data-reveal>
      {contacts.map((c) => (
        <div class="grid gap-1 rounded bg-graphite p-4 text-chalk md:p-5">
          <span class="text-[11px] font-semibold uppercase tracking-[.12em] text-steel">{c.who}</span>
          <span class="font-display text-[19px] leading-tight md:text-[21px]">{c.name}</span>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <a href={mail(c)} class="break-all font-mono text-[14px] text-lime underline-offset-4 hover:underline">{c.email}</a>
            <button type="button" class="copy-mail rounded border border-steel-dim px-2.5 py-1 text-[12px] font-semibold text-chalk hover:border-chalk" data-copy={c.email} aria-label={`Copy ${c.email}`}>Copy</button>
          </div>
        </div>
      ))}
      <a class="btn btn-dark justify-between" href={links.pic4ser} target="_blank" rel="noopener">Visit pic4ser.polito.it <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
