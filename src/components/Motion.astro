---
// Subtle reveals only: a short lift-in for content, the Idea skeleton drawing in, the How-it-works arrows.
// Everything is visible without JS; GSAP sets start states only when motion is allowed.
---
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const copy = async (text: string, btn: HTMLElement, done = 'Copied') => {
    try { await navigator.clipboard.writeText(text); }
    catch {
      const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
    }
    const prev = btn.textContent; btn.textContent = done;
    btn.classList.add('!bg-lime', '!text-graphite', '!border-lime');
    window.setTimeout(() => { btn.textContent = prev; btn.classList.remove('!bg-lime', '!text-graphite', '!border-lime'); }, 2000);
  };
  document.getElementById('copy-bib')?.addEventListener('click', (e) => copy(document.getElementById('bib')!.textContent ?? '', e.currentTarget as HTMLElement));
  document.querySelectorAll<HTMLButtonElement>('.copy-mail').forEach((b) => b.addEventListener('click', () => copy(b.dataset.copy!, b)));

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('js-motion');
    const ease = 'power2.out';

    gsap.from('[data-hero]', { y: 14, opacity: 0, duration: 0.8, ease, stagger: 0.08, delay: 0.1 });

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, { y: 12, opacity: 0, duration: 0.7, ease, scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
    });
    ScrollTrigger.batch('[data-reveal-stagger]', {
      start: 'top 90%', once: true,
      onEnter: (els) => gsap.from(els, { y: 12, opacity: 0, duration: 0.6, ease, stagger: 0.07 }),
    });

    const fig = document.getElementById('idea-fig');
    if (fig) {
      const tl = gsap.timeline({ scrollTrigger: { trigger: fig, start: 'top 75%', once: true } });
      tl.fromTo('#idea-skeleton .draw', { strokeDashoffset: (_i: number, t: Element) => getComputedStyle(t).getPropertyValue('--len') }, { strokeDashoffset: 0, duration: 1.1, ease: 'power2.inOut', stagger: 0.06 })
        .to('#idea-canopy', { opacity: 0.4, duration: 0.8, ease }, 0.3);
    }
    const how = document.getElementById('how-svg');
    if (how) {
      gsap.from('#how-svg .how-arrows line', { opacity: 0, x: -10, duration: 0.5, ease, stagger: 0.12, scrollTrigger: { trigger: how, start: 'top 80%', once: true } });
    }
  }
</script>
