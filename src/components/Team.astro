---
import { authors, links } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section id="team" class="light section border-t border-graphite/10">
  <div class="wrap">
    <span class="eyebrow text-steel-dim" data-reveal>Team</span>
    <h2 class="h2 mt-3" data-reveal>The people behind the map.</h2>
    <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 md:mt-[clamp(20px,4svh,44px)] md:grid-cols-5 md:gap-x-4 md:gap-y-6">
      {authors.map((a) => (
        <li class="grid grid-cols-[52px_minmax(0,1fr)] items-center gap-x-3 md:grid-cols-1 md:content-start md:items-start md:gap-2" data-reveal-stagger>
          <div class="row-span-3 grid aspect-square place-items-center overflow-hidden rounded bg-chalk-2 font-display text-[18px] text-steel-dim md:row-span-1 md:max-h-[22svh] md:text-[32px]" aria-hidden="true">
            {a.photo ? <img src={base + a.photo} alt="" class="h-full w-full object-cover grayscale" loading="lazy" /> : `${a.given[0]}${a.family[0]}`}
          </div>
          <h3 class="text-[15.5px] font-semibold leading-tight">{a.given} {a.family}</h3>
          {a.note && <p class="text-[13px] leading-snug text-graphite">{a.note}</p>}
          <p class="text-[12.5px] leading-snug text-steel-dim">{a.affil}</p>
        </li>
      ))}
    </ul>
    <div class="mt-[clamp(20px,4svh,48px)] flex flex-wrap items-center gap-x-10 gap-y-3 border-t border-graphite/10 pt-[clamp(16px,3svh,28px)]">
      <a href={links.pic4ser} target="_blank" rel="noopener" aria-label="Politecnico di Torino and PIC4SeR">
        <img src={base + 'logos/polito-pic4ser-graphite.png'} alt="Politecnico di Torino · PIC4SeR" width="966" height="193" class="h-10 w-auto md:h-12" loading="lazy" />
      </a>
      <p class="hidden max-w-[48ch] text-[13.5px] text-steel-dim sm:block">Department of Electronics and Telecommunications (DET) and PIC4SeR, the Interdepartmental Centre for Service Robotics, Politecnico di Torino.</p>
    </div>
  </div>
</section>
