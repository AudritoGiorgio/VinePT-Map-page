---
import { enables } from '../data/site';
---
<section id="enables" class="light section border-t border-graphite/10">
  <div class="wrap">
    <span class="eyebrow text-steel-dim" data-reveal>What it enables</span>
    <div class="mt-3 grid gap-3 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:items-end md:gap-12">
    <h2 class="h2 max-w-[20ch]" data-reveal>One map. Every machine in the row.</h2>
    <p class="lede text-body" data-reveal>A stable skeleton map is infrastructure. Automation anchors to it instead of to the leaves. Here is what it enables.</p>
    </div>
    <div class="snap-row mt-6 md:mt-[clamp(20px,4svh,44px)] md:grid md:grid-cols-2 md:gap-px md:border md:border-graphite/10 md:bg-graphite/10 lg:grid-cols-3">
      {enables.map((e) => (
        <article class="grid content-start gap-2 border border-graphite/10 bg-chalk p-5 transition-colors hover:bg-white md:border-0 md:p-[clamp(16px,2.6svh,26px)]" data-reveal-stagger>
          <span class="font-mono text-[11px] uppercase tracking-[.08em] text-steel-dim">{e.scope}</span>
          <h3 class="font-display text-[20px] leading-[1.15] md:text-[22px]">{e.title}</h3>
          <p class="text-[14.5px] leading-[1.5] text-body">{e.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
